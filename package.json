{
  "name": "overseer",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.tests.json --noEmit",
    "pretest": "npm run build && tsc -p tsconfig.tests.json",
    "test": "node --enable-source-maps --test .test-dist/tests/*.test.js",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js"
  },
  "author": "Wire",
  "license": "ISC",
  "description": "Authenticated deployment and Docker server management service",
  "dependencies": {
    "@sentry/node": "^10.78.0",
    "busboy": "^1.6.0",
    "tar-stream": "^3.2.2",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  }
}
