# Required. Generate with: openssl rand -hex 32
API_TOKEN=

# Local HTTP listener; use a TLS reverse proxy for remote access.
SERVER_HOST=127.0.0.1
SERVER_PORT=8564

SERVERS_ROOT=/servers
BYOND_ROOT=/byond
RUSTG_ROOT=/rust-g
CONTAINER_PREFIX=ss13-
# Numeric host ownership IDs. With Compose userns_mode: host, use the game
# user's mapped host UID/GID, not its IDs inside the game container. Verify these.
GAME_USER_OWNER=306969
GAME_USER_GROUP=306969

# Per archive, per request, and per extracted archive, respectively (bytes).
MAX_UPLOAD_BYTES=536870912
MAX_REQUEST_BYTES=1610678272
MAX_EXTRACTED_BYTES=2147483648
MAX_ARCHIVE_ENTRIES=100000
UPLOAD_TIMEOUT_MS=300000
REQUEST_TIMEOUT_MS=330000
COMMAND_TIMEOUT_MS=120000
RESTART_TIMEOUT_MS=300000
OPERATION_LIMIT=1000
OPERATION_TTL_MS=86400000

# Optional telemetry.
SENTRY_DSN=

# Docker Compose only: host publication address and shutdown allowance.
OVERSEER_BIND_ADDRESS=127.0.0.1
OVERSEER_STOP_GRACE_PERIOD=310s

# Published image for the production Compose override.
OVERSEER_IMAGE=ghcr.io/goonstation/overseer:latest
